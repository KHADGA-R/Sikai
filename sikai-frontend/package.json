{
  "name": "sikai-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json --open",
    "start:api": "ng serve --proxy-config proxy.conf.json",
    "email:server": "node server/email.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "playwright test",
    "test:integration": "playwright test",
    "test:unit": "node scripts/test-instructor.mjs && node scripts/test-grades.mjs && node scripts/test-learning-progress.mjs"
  },
  "dependencies": {
    "@angular/animations": "~20.3.0",
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/router": "~20.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@playwright/test": "^1.65.1",
    "typescript": "~5.9.2"
  }
}
